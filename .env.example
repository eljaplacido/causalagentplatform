# Reference for the platform's environment variables. The backend reads
# backend/.env (start from backend/.env.example); this root file is a
# reference, not something any process loads.

# ── Environment ───────────────────────────────────────────────────────────
# local -> SQLite and the dev auth bypass may be enabled; anything else ->
# PostgreSQL (backend/src/db/factory.py). The variable is ENV, not ENVIRONMENT.
ENV=local
DEV_AUTH_BYPASS=true

# ── Database ──────────────────────────────────────────────────────────────
# Ignored when ENV=local (SQLite at SQLITE_PATH, default backend/local_dev.db).
# With any other ENV: a Cloud SQL socket via CLOUD_SQL_INSTANCE_CONNECTION_NAME,
# or this URL.
# DATABASE_URL=postgresql+asyncpg://causal:causal_local_dev@localhost:5432/causalplatform

# ── Neo4j (optional; SQL fallback when unset) ─────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=causal_local_dev

# ── Firebase Auth (non-local environments) ────────────────────────────────
# Service-account credentials via GCP ADC, or a file path here. Never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk-local.json

# ── LLM providers (optional) ──────────────────────────────────────────────
# src/agents/llm_factory.py can build a client for these, but nothing calls it
# today, so none is needed. See backend/.env.example for the full list.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:49234
NEXT_PUBLIC_ENVIRONMENT=local

# ── Future (no code reads these yet) ──────────────────────────────────────
# docker-compose.yml runs Kafka and Redis under the `future` profile; no Kafka
# or Redis client exists in the tree (`kafka-streaming` in the register).
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_URL=redis://localhost:6379

# ── Environment: local | staging | production ─────────────────────────────
ENVIRONMENT=local

# ── Database ──────────────────────────────────────────────────────────────
# Local: leave unset to use SQLite (factory auto-detects)
# Staging/Production: full postgresql+asyncpg URL
DATABASE_URL=postgresql+asyncpg://causal:causal_local_dev@localhost:5432/causalplatform

# ── Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=causal_local_dev

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Firebase Auth ─────────────────────────────────────────────────────────
# Path to Firebase service account JSON (local dev only — never commit this file)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk-local.json
# OR use GCP ADC on Cloud Run (no file needed)

# ── LLM Providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
# Fallbacks (optional):
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=local

# ── Redis (session cache) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Guardian ──────────────────────────────────────────────────────────────
# Hallucination risk threshold (pause for human review above this)
HALLUCINATION_RISK_THRESHOLD=0.7
# Max agent cycles before mandatory escalation
MAX_AGENT_CYCLES=5

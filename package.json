{
  "name": "causalplatform",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Enterprise Causal Platform — monorepo root",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "type-check": "npm run type-check --workspaces --if-present",
    "build:types": "npm run build --workspace=packages/semantic-types",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}

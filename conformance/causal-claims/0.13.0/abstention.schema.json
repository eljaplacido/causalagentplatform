{
  "$defs": {
    "AbstentionReason": {
      "enum": [
        "NON_IDENTIFIABLE",
        "POSITIVITY",
        "LOW_N",
        "UNAPPROVED_ASSUMPTION",
        "CI_TOO_WIDE",
        "DESIGN_CHECK_FAILED",
        "RUNG_MISMATCH",
        "INVALID_ADJUSTMENT_SET",
        "WEAK_INSTRUMENT",
        "NO_ESTIMATOR",
        "INVALID_INPUT"
      ],
      "title": "AbstentionReason",
      "type": "string"
    },
    "BalanceRow": {
      "additionalProperties": false,
      "properties": {
        "covariate": {
          "title": "Covariate",
          "type": "string"
        },
        "smd_raw": {
          "title": "Smd Raw",
          "type": "number"
        },
        "smd_weighted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Smd Weighted"
        }
      },
      "required": [
        "covariate",
        "smd_raw",
        "smd_weighted"
      ],
      "title": "BalanceRow",
      "type": "object"
    },
    "CausalQuery": {
      "additionalProperties": false,
      "properties": {
        "adjust_for": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A user-chosen adjustment set. It is validated against the graph and refused if it is not a valid adjustment set.",
          "title": "Adjust For"
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Randomized designs only: the column identifying the unit of randomization (service, region, tenant) when outcomes are measured on finer units (requests, users). Standard errors are then cluster-robust; treatment must be constant within a cluster.",
          "title": "Cluster"
        },
        "control_group": {
          "default": "never_treated",
          "description": "Panel designs only: never_treated compares each cohort with units never treated; not_yet_treated adds cohorts not yet treated at that period, for rollouts that reach every unit.",
          "enum": [
            "never_treated",
            "not_yet_treated"
          ],
          "title": "Control Group",
          "type": "string"
        },
        "covariates": {
          "default": [],
          "description": "Panel designs only: time-invariant, pre-treatment columns under which parallel trends is assumed to hold; each group-time effect is then doubly robust (Sant'Anna & Zhao 2020). Covariates that vary within a unit, and poor overlap, are refused.",
          "items": {
            "type": "string"
          },
          "title": "Covariates",
          "type": "array"
        },
        "design": {
          "$ref": "#/$defs/Design",
          "default": "observational"
        },
        "estimand": {
          "default": "ate",
          "description": "ate: average effect over the population. att: average effect on the treated units (binary treatment only; needs overlap in one direction only).",
          "enum": [
            "ate",
            "att"
          ],
          "title": "Estimand",
          "type": "string"
        },
        "expected_treated_share": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Treated Share"
        },
        "horizon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "instruments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruments"
        },
        "negative_control_outcomes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Negative Control Outcomes",
          "type": "array"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "outcome_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Proxies",
          "type": "array"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "rung": {
          "$ref": "#/$defs/Rung",
          "default": "intervention"
        },
        "segment_by": {
          "default": [],
          "description": "Discrete, pre-treatment columns to estimate the effect within, declared before the answer is seen. The kernel does not search for subgroups: finding the subgroup with the largest effect is a different activity with different statistics, and reporting it as if it had been declared is how a team fools itself.",
          "items": {
            "type": "string"
          },
          "title": "Segment By",
          "type": "array"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Randomized designs only: the column giving each unit's arrival order. When set, the effect is reported as an anytime-valid confidence sequence at every look, so the analysis may be read -- and stopped -- as often as wanted without inflating its error rate. Needs `expected_treated_share`, the known allocation probability.",
          "title": "Sequence"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panel designs only: the column holding the period, as an integer or an ordered value. Periods are the distinct values in sorted order.",
          "title": "Time"
        },
        "treatment": {
          "title": "Treatment",
          "type": "string"
        },
        "treatment_levels": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(control, treated). Defaults to (0, 1) for a binary treatment; for a continuous treatment the effect is reported per unit unless levels are given.",
          "title": "Treatment Levels"
        },
        "treatment_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Treatment Proxies",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panel designs only: the column identifying the unit observed repeatedly.",
          "title": "Unit"
        },
        "washout": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Switchback designs (cluster = the time block, time = within-block time): drop, from every block, the observations within this many time units of its start -- the settling-in after a switch. Every block, not only switched ones, so a block's retained window never depends on its neighbour's arm.",
          "title": "Washout"
        }
      },
      "required": [
        "treatment",
        "outcome"
      ],
      "title": "CausalQuery",
      "type": "object"
    },
    "ConditionCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "holds": {
          "title": "Holds",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "holds"
      ],
      "title": "ConditionCheck",
      "type": "object"
    },
    "Design": {
      "enum": [
        "observational",
        "randomized",
        "difference_in_differences"
      ],
      "title": "Design",
      "type": "string"
    },
    "DesignCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "DesignCheck",
      "type": "object"
    },
    "Diagnostics": {
      "additionalProperties": false,
      "properties": {
        "balance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BalanceRow"
          },
          "title": "Balance",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DesignCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "first_stage_f": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Stage F"
        },
        "icc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cluster-randomized designs: estimated intra-cluster correlation of the outcome within arms. With clusters of size m, units carry about 1/(1 + (m-1)\u00b7ICC) of the information independent units would.",
          "title": "Icc"
        },
        "n_clusters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Clusters"
        },
        "n_control": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Control"
        },
        "n_dropped_missing": {
          "default": 0,
          "title": "N Dropped Missing",
          "type": "integer"
        },
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_treated": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Treated"
        },
        "n_used": {
          "title": "N Used",
          "type": "integer"
        },
        "outcome_sd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard deviation of the outcome on the analysed rows. Reported because sizing a follow-up experiment needs it, and because an effect is only interpretable against the outcome's spread.",
          "title": "Outcome Sd"
        },
        "overlap": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlapDiagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "propensity": {
          "anyOf": [
            {
              "$ref": "#/$defs/PropensityDiagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "srm_p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Srm P Value"
        },
        "treatment_kind": {
          "enum": [
            "binary",
            "continuous"
          ],
          "title": "Treatment Kind",
          "type": "string"
        }
      },
      "required": [
        "n_rows",
        "n_used",
        "treatment_kind"
      ],
      "title": "Diagnostics",
      "type": "object"
    },
    "IdentificationCertificate": {
      "additionalProperties": false,
      "properties": {
        "adjustment_set": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adjustment Set",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionCheck"
          },
          "title": "Conditions",
          "type": "array"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "estimand": {
          "description": "The identifying functional, as a readable expression.",
          "title": "Estimand",
          "type": "string"
        },
        "general_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result of the complete ID algorithm on the same graph: the identifying expression, or 'FAIL: hedge ...'. Every strategy above must agree with it.",
          "title": "General Id"
        },
        "graph_digest": {
          "title": "Graph Digest",
          "type": "string"
        },
        "instruments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Instruments",
          "type": "array"
        },
        "mediators": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mediators",
          "type": "array"
        },
        "outcome_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Proxies",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/IdentificationStatus"
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "treatment_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Treatment Proxies",
          "type": "array"
        },
        "unreviewed_edges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unreviewed Edges",
          "type": "array"
        }
      },
      "required": [
        "status",
        "strategy",
        "tier",
        "estimand",
        "engine",
        "graph_digest"
      ],
      "title": "IdentificationCertificate",
      "type": "object"
    },
    "IdentificationStatus": {
      "enum": [
        "identified",
        "not_identified"
      ],
      "title": "IdentificationStatus",
      "type": "string"
    },
    "OverlapDiagnostics": {
      "additionalProperties": false,
      "description": "Where positivity fails or is thin beyond what one propensity model can express. The\nthresholds are the policy's (overlap_region_*, limited_overlap_bounds); the region check\nran when ``diagnostics.checks`` has its row.",
      "properties": {
        "limited_overlap": {
          "description": "The share exceeds max_extreme_propensity_share: there the estimate rests on few comparable units or on the outcome model.",
          "title": "Limited Overlap",
          "type": "boolean"
        },
        "limited_share": {
          "description": "Share of units (ATT: treated units) whose propensity is outside limited_overlap_bounds (ATT: above the upper one).",
          "title": "Limited Share",
          "type": "number"
        },
        "regions": {
          "default": [],
          "description": "The violation regions, largest first (at most ten).",
          "items": {
            "$ref": "#/$defs/OverlapRegion"
          },
          "title": "Regions",
          "type": "array"
        },
        "violation_share": {
          "description": "ATE: share of units in a violation region. ATT: share of treated units in a region without controls.",
          "title": "Violation Share",
          "type": "number"
        }
      },
      "required": [
        "violation_share",
        "limited_share",
        "limited_overlap"
      ],
      "title": "OverlapDiagnostics",
      "type": "object"
    },
    "OverlapRegion": {
      "additionalProperties": false,
      "description": "A region of the adjustment covariates in which one arm (almost) never occurs.",
      "properties": {
        "missing_arm": {
          "enum": [
            "treated",
            "control"
          ],
          "title": "Missing Arm",
          "type": "string"
        },
        "n_treated": {
          "title": "N Treated",
          "type": "integer"
        },
        "n_units": {
          "description": "Held-out units in the region: the ones that judged it.",
          "title": "N Units",
          "type": "integer"
        },
        "rule": {
          "description": "The region, as a conjunction of conditions on the adjustment covariates as encoded (categorical ones as dummy columns).",
          "title": "Rule",
          "type": "string"
        },
        "upper_bound": {
          "description": "One-sided upper confidence bound on the probability of the missing arm in this region, from the held-out units.",
          "title": "Upper Bound",
          "type": "number"
        }
      },
      "required": [
        "rule",
        "n_units",
        "n_treated",
        "missing_arm",
        "upper_bound"
      ],
      "title": "OverlapRegion",
      "type": "object"
    },
    "PropensityDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "ess_control": {
          "title": "Ess Control",
          "type": "number"
        },
        "ess_treated": {
          "title": "Ess Treated",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "share_outside_bounds": {
          "title": "Share Outside Bounds",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "share_outside_bounds",
        "ess_treated",
        "ess_control"
      ],
      "title": "PropensityDiagnostics",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "title": "Contract Version",
          "type": "string"
        },
        "core_version": {
          "title": "Core Version",
          "type": "string"
        },
        "data_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Digest"
        },
        "graph_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Digest"
        },
        "policy_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Digest"
        },
        "query_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Digest"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract_version",
        "core_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Rung": {
      "description": "Pearl's ladder. A query must declare which rung it asks about.",
      "enum": [
        "association",
        "intervention",
        "counterfactual"
      ],
      "title": "Rung",
      "type": "string"
    },
    "Strategy": {
      "enum": [
        "randomized",
        "backdoor",
        "frontdoor",
        "iv",
        "proximal",
        "id_general",
        "difference_in_differences"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "Tier": {
      "description": "Strength of identification.\n\nA -- identified nonparametrically from the graph alone.\nB -- identified only under additional parametric or structural assumptions\n     that the graph cannot express (e.g. effect homogeneity for IV).\nC -- reserved: identified only by an assumption outside the graph.\nD -- not identified.",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "$id": "urn:causalplatform:claims:0.13.0:abstention",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certificate": {
      "anyOf": [
        {
          "$ref": "#/$defs/IdentificationCertificate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "diagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "const": "refusal",
      "default": "refusal",
      "title": "Kind",
      "type": "string"
    },
    "missing_information": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "query": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalQuery"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "$ref": "#/$defs/AbstentionReason"
    }
  },
  "required": [
    "reason",
    "detail",
    "provenance"
  ],
  "title": "Abstention",
  "type": "object"
}

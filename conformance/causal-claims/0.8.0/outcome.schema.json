{
  "$defs": {
    "Abstention": {
      "additionalProperties": false,
      "properties": {
        "certificate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentificationCertificate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "refusal",
          "default": "refusal",
          "title": "Kind",
          "type": "string"
        },
        "missing_information": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausalQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "$ref": "#/$defs/AbstentionReason"
        }
      },
      "required": [
        "reason",
        "detail",
        "provenance"
      ],
      "title": "Abstention",
      "type": "object"
    },
    "AbstentionReason": {
      "enum": [
        "NON_IDENTIFIABLE",
        "POSITIVITY",
        "LOW_N",
        "UNAPPROVED_ASSUMPTION",
        "CI_TOO_WIDE",
        "DESIGN_CHECK_FAILED",
        "RUNG_MISMATCH",
        "INVALID_ADJUSTMENT_SET",
        "WEAK_INSTRUMENT",
        "NO_ESTIMATOR",
        "INVALID_INPUT"
      ],
      "title": "AbstentionReason",
      "type": "string"
    },
    "ApparatusFailure": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "kind": {
          "const": "apparatus_failure",
          "default": "apparatus_failure",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "error_type",
        "detail",
        "provenance"
      ],
      "title": "ApparatusFailure",
      "type": "object"
    },
    "BalanceRow": {
      "additionalProperties": false,
      "properties": {
        "covariate": {
          "title": "Covariate",
          "type": "string"
        },
        "smd_raw": {
          "title": "Smd Raw",
          "type": "number"
        },
        "smd_weighted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Smd Weighted"
        }
      },
      "required": [
        "covariate",
        "smd_raw",
        "smd_weighted"
      ],
      "title": "BalanceRow",
      "type": "object"
    },
    "CausalQuery": {
      "additionalProperties": false,
      "properties": {
        "adjust_for": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A user-chosen adjustment set. It is validated against the graph and refused if it is not a valid adjustment set.",
          "title": "Adjust For"
        },
        "cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Randomized designs only: the column identifying the unit of randomization (service, region, tenant) when outcomes are measured on finer units (requests, users). Standard errors are then cluster-robust; treatment must be constant within a cluster.",
          "title": "Cluster"
        },
        "design": {
          "$ref": "#/$defs/Design",
          "default": "observational"
        },
        "estimand": {
          "default": "ate",
          "description": "ate: average effect over the population. att: average effect on the treated units (binary treatment only; needs overlap in one direction only).",
          "enum": [
            "ate",
            "att"
          ],
          "title": "Estimand",
          "type": "string"
        },
        "expected_treated_share": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Treated Share"
        },
        "horizon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "instruments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruments"
        },
        "negative_control_outcomes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Negative Control Outcomes",
          "type": "array"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "outcome_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Proxies",
          "type": "array"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "rung": {
          "$ref": "#/$defs/Rung",
          "default": "intervention"
        },
        "segment_by": {
          "default": [],
          "description": "Discrete, pre-treatment columns to estimate the effect within, declared before the answer is seen. The kernel does not search for subgroups: finding the subgroup with the largest effect is a different activity with different statistics, and reporting it as if it had been declared is how a team fools itself.",
          "items": {
            "type": "string"
          },
          "title": "Segment By",
          "type": "array"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Randomized designs only: the column giving each unit's arrival order. When set, the effect is reported as an anytime-valid confidence sequence at every look, so the analysis may be read -- and stopped -- as often as wanted without inflating its error rate. Needs `expected_treated_share`, the known allocation probability.",
          "title": "Sequence"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panel designs only: the column holding the period, as an integer or an ordered value. Periods are the distinct values in sorted order.",
          "title": "Time"
        },
        "treatment": {
          "title": "Treatment",
          "type": "string"
        },
        "treatment_levels": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(control, treated). Defaults to (0, 1) for a binary treatment; for a continuous treatment the effect is reported per unit unless levels are given.",
          "title": "Treatment Levels"
        },
        "treatment_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Treatment Proxies",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Panel designs only: the column identifying the unit observed repeatedly.",
          "title": "Unit"
        }
      },
      "required": [
        "treatment",
        "outcome"
      ],
      "title": "CausalQuery",
      "type": "object"
    },
    "CausalResult": {
      "additionalProperties": false,
      "properties": {
        "certificate": {
          "$ref": "#/$defs/IdentificationCertificate"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "diagnostics": {
          "$ref": "#/$defs/Diagnostics"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/EstimateRecord"
          },
          "title": "Estimates",
          "type": "array"
        },
        "event_study": {
          "default": [],
          "description": "Panel designs only: the effect by periods since adoption, pre-periods included as placebos.",
          "items": {
            "$ref": "#/$defs/EventTimeEffect"
          },
          "title": "Event Study",
          "type": "array"
        },
        "heterogeneity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Heterogeneity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "result",
          "default": "result",
          "title": "Kind",
          "type": "string"
        },
        "primary": {
          "$ref": "#/$defs/EstimateRecord"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "query": {
          "$ref": "#/$defs/CausalQuery"
        },
        "refutations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RefutationResult"
          },
          "title": "Refutations",
          "type": "array"
        },
        "result_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the JCS form of this object without this field.",
          "title": "Result Digest"
        },
        "segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentEffect"
          },
          "title": "Segments",
          "type": "array"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequential": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequentialSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sequential designs only: the confidence sequence at every look. `primary` carries the last look, with the sequence as its interval."
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "triangulation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Triangulation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "query",
        "certificate",
        "primary",
        "estimates",
        "diagnostics",
        "provenance"
      ],
      "title": "CausalResult",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "A number that may appear in prose, bound to the field it came from.\n\nNarratives reference claims as ``\u27e6claim:<id>\u27e7``; the renderer substitutes\n``text`` and the verifier rejects any number in the prose that is not a claim.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "JSON pointer into the result that holds the value.",
          "title": "Path",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "value",
        "text",
        "path"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ConditionCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "holds": {
          "title": "Holds",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "holds"
      ],
      "title": "ConditionCheck",
      "type": "object"
    },
    "Design": {
      "enum": [
        "observational",
        "randomized",
        "difference_in_differences"
      ],
      "title": "Design",
      "type": "string"
    },
    "DesignCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "DesignCheck",
      "type": "object"
    },
    "Diagnostics": {
      "additionalProperties": false,
      "properties": {
        "balance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BalanceRow"
          },
          "title": "Balance",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DesignCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "first_stage_f": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Stage F"
        },
        "icc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cluster-randomized designs: estimated intra-cluster correlation of the outcome within arms. With clusters of size m, units carry about 1/(1 + (m-1)\u00b7ICC) of the information independent units would.",
          "title": "Icc"
        },
        "n_clusters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Clusters"
        },
        "n_control": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Control"
        },
        "n_dropped_missing": {
          "default": 0,
          "title": "N Dropped Missing",
          "type": "integer"
        },
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_treated": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Treated"
        },
        "n_used": {
          "title": "N Used",
          "type": "integer"
        },
        "outcome_sd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard deviation of the outcome on the analysed rows. Reported because sizing a follow-up experiment needs it, and because an effect is only interpretable against the outcome's spread.",
          "title": "Outcome Sd"
        },
        "propensity": {
          "anyOf": [
            {
              "$ref": "#/$defs/PropensityDiagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "srm_p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Srm P Value"
        },
        "treatment_kind": {
          "enum": [
            "binary",
            "continuous"
          ],
          "title": "Treatment Kind",
          "type": "string"
        }
      },
      "required": [
        "n_rows",
        "n_used",
        "treatment_kind"
      ],
      "title": "Diagnostics",
      "type": "object"
    },
    "EstimateRecord": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci_null_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Null Reason"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "estimand": {
          "title": "Estimand",
          "type": "string"
        },
        "estimator": {
          "title": "Estimator",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "n_used": {
          "title": "N Used",
          "type": "integer"
        },
        "point": {
          "title": "Point",
          "type": "number"
        },
        "se": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Se"
        }
      },
      "required": [
        "estimator",
        "family",
        "estimand",
        "point",
        "se",
        "ci",
        "n_used"
      ],
      "title": "EstimateRecord",
      "type": "object"
    },
    "EventTimeEffect": {
      "additionalProperties": false,
      "description": "The effect ``event_time`` periods after adoption (negative: before it).\n\nPre-adoption event times are placebo estimates -- zero in expectation under parallel\ntrends -- and period ``-1`` is the base, zero by construction, so it is not reported.",
      "properties": {
        "cohorts": {
          "description": "How many adoption cohorts contribute to this event time.",
          "title": "Cohorts",
          "type": "integer"
        },
        "estimate": {
          "$ref": "#/$defs/EstimateRecord"
        },
        "event_time": {
          "title": "Event Time",
          "type": "integer"
        }
      },
      "required": [
        "event_time",
        "estimate",
        "cohorts"
      ],
      "title": "EventTimeEffect",
      "type": "object"
    },
    "Heterogeneity": {
      "additionalProperties": false,
      "description": "Whether the segments differ at all, asked once, before any of them are compared.",
      "properties": {
        "alpha": {
          "title": "Alpha",
          "type": "number"
        },
        "df": {
          "title": "Df",
          "type": "integer"
        },
        "differs": {
          "description": "False means the data cannot distinguish these segments from one another. Acting on the differences anyway is the error this test exists to prevent.",
          "title": "Differs",
          "type": "boolean"
        },
        "method": {
          "const": "cochran_q",
          "default": "cochran_q",
          "title": "Method",
          "type": "string"
        },
        "p_value": {
          "title": "P Value",
          "type": "number"
        },
        "segments_compared": {
          "title": "Segments Compared",
          "type": "integer"
        },
        "statistic": {
          "title": "Statistic",
          "type": "number"
        }
      },
      "required": [
        "statistic",
        "df",
        "p_value",
        "alpha",
        "differs",
        "segments_compared"
      ],
      "title": "Heterogeneity",
      "type": "object"
    },
    "IdentificationCertificate": {
      "additionalProperties": false,
      "properties": {
        "adjustment_set": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adjustment Set",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionCheck"
          },
          "title": "Conditions",
          "type": "array"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "estimand": {
          "description": "The identifying functional, as a readable expression.",
          "title": "Estimand",
          "type": "string"
        },
        "general_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result of the complete ID algorithm on the same graph: the identifying expression, or 'FAIL: hedge ...'. Every strategy above must agree with it.",
          "title": "General Id"
        },
        "graph_digest": {
          "title": "Graph Digest",
          "type": "string"
        },
        "instruments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Instruments",
          "type": "array"
        },
        "mediators": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mediators",
          "type": "array"
        },
        "outcome_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outcome Proxies",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/IdentificationStatus"
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strategy"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "treatment_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Treatment Proxies",
          "type": "array"
        },
        "unreviewed_edges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unreviewed Edges",
          "type": "array"
        }
      },
      "required": [
        "status",
        "strategy",
        "tier",
        "estimand",
        "engine",
        "graph_digest"
      ],
      "title": "IdentificationCertificate",
      "type": "object"
    },
    "IdentificationStatus": {
      "enum": [
        "identified",

{
  "$defs": {
    "Design": {
      "enum": [
        "observational",
        "randomized"
      ],
      "title": "Design",
      "type": "string"
    },
    "Rung": {
      "description": "Pearl's ladder. A query must declare which rung it asks about.",
      "enum": [
        "association",
        "intervention",
        "counterfactual"
      ],
      "title": "Rung",
      "type": "string"
    }
  },
  "$id": "urn:causalplatform:claims:0.2.0:causal_query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjust_for": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A user-chosen adjustment set. It is validated against the graph and refused if it is not a valid adjustment set.",
      "title": "Adjust For"
    },
    "design": {
      "$ref": "#/$defs/Design",
      "default": "observational"
    },
    "estimand": {
      "default": "ate",
      "description": "ate: average effect over the population. att: average effect on the treated units (binary treatment only; needs overlap in one direction only).",
      "enum": [
        "ate",
        "att"
      ],
      "title": "Estimand",
      "type": "string"
    },
    "expected_treated_share": {
      "anyOf": [
        {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Treated Share"
    },
    "horizon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon"
    },
    "instruments": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instruments"
    },
    "negative_control_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Negative Control Outcomes",
      "type": "array"
    },
    "outcome": {
      "title": "Outcome",
      "type": "string"
    },
    "outcome_proxies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Outcome Proxies",
      "type": "array"
    },
    "population": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Population"
    },
    "rung": {
      "$ref": "#/$defs/Rung",
      "default": "intervention"
    },
    "treatment": {
      "title": "Treatment",
      "type": "string"
    },
    "treatment_levels": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "(control, treated). Defaults to (0, 1) for a binary treatment; for a continuous treatment the effect is reported per unit unless levels are given.",
      "title": "Treatment Levels"
    },
    "treatment_proxies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Treatment Proxies",
      "type": "array"
    }
  },
  "required": [
    "treatment",
    "outcome"
  ],
  "title": "CausalQuery",
  "type": "object"
}

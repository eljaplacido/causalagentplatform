{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "default": "directed",
          "enum": [
            "directed",
            "bidirected"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/EdgeOrigin",
          "default": "human"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EdgeStatus",
          "default": "asserted"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeOrigin": {
      "description": "Who or what put an edge in the graph.",
      "enum": [
        "human",
        "data",
        "experiment",
        "literature",
        "llm_prior"
      ],
      "title": "EdgeOrigin",
      "type": "string"
    },
    "EdgeStatus": {
      "description": "Review state of an edge.\n\n``asserted`` is a statement by whoever supplied the graph. ``proposed`` is a\nsuggestion (the default for ``llm_prior`` edges) that has not been reviewed.\n``refuted`` edges are dropped before analysis.",
      "enum": [
        "asserted",
        "proposed",
        "approved",
        "refuted"
      ],
      "title": "EdgeStatus",
      "type": "string"
    }
  },
  "$id": "urn:causalplatform:claims:0.4.0:causal_graph",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A causal graph over named variables.\n\nDirected edges are causal claims. A bidirected edge ``a <-> b`` says an\nunmeasured common cause of ``a`` and ``b`` may exist. Nodes listed in\n``latent`` are unmeasured: they may appear in edges but never in data.\nThe edges that are *absent* are the strongest assumptions in the graph.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "latent": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Latent",
      "type": "array"
    },
    "nodes": {
      "items": {
        "type": "string"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "CausalGraph",
  "type": "object"
}

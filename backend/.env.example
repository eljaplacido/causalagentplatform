# ── Environment ────────────────────────────────────────────────────────────
ENV=local
DEV_AUTH_BYPASS=true

# ── Guardian signing key ──────────────────────────────────────────────────
# Signs every Guardian verdict. Optional with ENV=local (a per-process key is
# generated and logged at CRITICAL); with any other ENV the backend refuses to
# start without one of at least 32 bytes. Generate:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Every secret below also accepts <NAME>_FILE, a path to a file holding it
# (Docker/Kubernetes secrets, a secret manager's file mount); never set both.
# GUARDIAN_SIGNING_KEY=
# GUARDIAN_SIGNING_KEY_FILE=/run/secrets/guardian_signing_key
# Retired keys that still verify (rotation), comma- or newline-separated:
# GUARDIAN_SIGNING_KEYS_PREVIOUS=

# ── Database ───────────────────────────────────────────────────────────────
# ENV decides the engine (src/db/factory.py): ENV=local -> SQLite at SQLITE_PATH
# (default backend/local_dev.db) and DATABASE_URL is ignored; any other ENV ->
# PostgreSQL via CLOUD_SQL_INSTANCE_CONNECTION_NAME or this URL.
# SQLITE_PATH=./local_dev.db
# As causal_app, the role row-level security binds; the backend refuses to start as
# the owner (docs/QUICKSTART.md). The compose stack's local-dev login:
# DATABASE_URL=postgresql+asyncpg://causal_app:causal_app_local_dev@localhost:5432/causalplatform

# ── Neo4j (optional: experience buffer + drift-alert storage) ──────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=causal_local_dev

# ── Firebase Auth (non-local environments) ─────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk-local.json

# ═══════════════════════════════════════════════════════════════════════════
# LLM Providers (optional). src/agents/llm_factory.py resolves one from these,
# first set wins (Ollama first: local, no cloud cost). None is required: with
# none set, nothing calls a model and every explanation is the deterministic one.
# Callers: the SimulationAgent's narration and POST /api/v1/decisions with
# narrate: true, language only, kept only if PR-002 grounding passes.
# ═══════════════════════════════════════════════════════════════════════════

# ── Option 1: Ollama (local) ───────────────────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:122b                # default: qwen3.5:122b
# OLLAMA_CAUSAL_MODEL=                     # override for causal_reasoning (the narration's
#                                          # capability), e.g. qwen2.5:7b-instruct
# OLLAMA_FAST_MODEL=                       # override for fast_classification
# OLLAMA_DOC_MODEL=                        # override for document_extraction
# OLLAMA_CODE_MODEL=                       # override for code_generation
# OLLAMA_MAX_TOKENS=4096
# LLM_TIMEOUT_SECONDS=60                   # per narration call; on timeout the fallback is used

# ── Option 2: Anthropic Claude (cloud) ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20250413

# ── Option 3: OpenAI (cloud) ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini

# ── Option 4: DeepSeek (cloud) ─────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

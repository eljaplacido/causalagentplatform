# ── Environment ────────────────────────────────────────────────────────────
ENV=local
DEV_AUTH_BYPASS=true

# ── Database ───────────────────────────────────────────────────────────────
# Local: leave unset to use SQLite (factory auto-detects)
# Staging/Production: full postgresql+asyncpg URL
# DATABASE_URL=postgresql+asyncpg://causal:causal_local_dev@localhost:5432/causalplatform

# ── Neo4j (for graph operations + experience buffer) ───────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=causal_local_dev

# ── Kafka ──────────────────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Firebase Auth ──────────────────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk-local.json

# ═══════════════════════════════════════════════════════════════════════════
# LLM Providers (pick one — provider-agnostic routing in llm_factory.py)
# ═══════════════════════════════════════════════════════════════════════════

# ── Option 1: Ollama (local) — gx10 primary ────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:122b                # default: qwen3.5:122b
# OLLAMA_CAUSAL_MODEL=                     # override for causal_reasoning
# OLLAMA_FAST_MODEL=                       # override for fast_classification
# OLLAMA_DOC_MODEL=                        # override for document_extraction
# OLLAMA_CODE_MODEL=                       # override for code_generation
# OLLAMA_MAX_TOKENS=4096

# ── Option 2: OpenFang (FangLMs) — gx10 secondary ──────────────────────────
# OPENFANG_BASE_URL=http://127.0.0.1:4200

# ── Option 3: Anthropic Claude (cloud) ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20250413

# ── Option 4: OpenAI (cloud) ───────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini

# ── Option 5: DeepSeek (cloud) ─────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ═══════════════════════════════════════════════════════════════════════════
# Guardian
# ═══════════════════════════════════════════════════════════════════════════
HALLUCINATION_RISK_THRESHOLD=0.7
MAX_AGENT_CYCLES=5

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
